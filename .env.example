# Salin menjadi .env untuk development lokal (XAMPP). JANGAN commit file .env!
# Di Vercel: isi variabel yang sama di Project Settings -> Environment Variables.

DB_HOST=mysql-xxxxxxxx-namaproject.j.aivencloud.com
DB_PORT=22147
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=isi_password_aiven
# Opsional: path ca.pem dari Aiven (Overview -> CA certificate) untuk verifikasi SSL penuh
DB_SSL_CA=
# Set false jika memakai MySQL lokal tanpa SSL
DB_SSL=true

# WhatsApp via Fonnte
FONNTE_TOKEN=isi_token_fonnte
WA_TARGET=08xxxxxxxxxx

# Saluran notifikasi: wa (default), telegram, atau wa,telegram (keduanya)
NOTIF_VIA=wa
# Telegram Bot (gratis): token dari @BotFather, chat id orang/grup (bisa lebih dari 1, pisah koma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Kunci rahasia untuk cron-job.org -> /cron_wa_reminder.php?key=ISI_INI
CRON_SECRET=ganti_dengan_string_acak_panjang

# true = halaman Daftar terbuka untuk umum. Default false (akun dibuat lewat menu Kelola User)
ALLOW_REGISTER=false
APP_TIMEZONE=Asia/Jakarta
# true = tampilkan error PHP di layar (hanya untuk lokal)
APP_DEBUG=false
