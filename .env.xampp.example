# Konfigurasi untuk menjalankan aplikasi di XAMPP (localhost).
# Copy file ini lalu ganti namanya menjadi .env

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reminders_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Isi jika ingin mencoba kirim WA dari localhost
FONNTE_TOKEN=
WA_TARGET=

# Saluran notifikasi, pisahkan dengan koma: wa (default), telegram, email. Contoh: wa,telegram,email
NOTIF_VIA=wa
# Telegram Bot (gratis): token dari @BotFather, chat id orang/grup (bisa lebih dari 1, pisah koma)
TELEGRAM_BOT_TOKEN=
# Opsional: penerima Telegram bisa diatur dari dashboard (kartu Penerima Telegram)
TELEGRAM_CHAT_ID=

# Email (SMTP via PHPMailer). Gmail: aktifkan Verifikasi 2 Langkah, lalu buat App Password
# (myaccount.google.com/apppasswords) dan isi di SMTP_PASS. JANGAN pakai password Gmail biasa.
# Agar pengingat otomatis juga dikirim lewat email, tambahkan email di NOTIF_VIA (contoh: wa,telegram,email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opsional: alamat & nama pengirim (default: SMTP_USER dan "Pengingat Deadline")
EMAIL_PENGIRIM=
EMAIL_NAMA_PENGIRIM=Pengingat Deadline
# Opsional: penerima email bisa diatur dari dashboard (menu Penerima -> Email)
EMAIL_TARGET=

CRON_SECRET=rahasia-lokal
ALLOW_REGISTER=false
APP_TIMEZONE=Asia/Jakarta
APP_DEBUG=true

# ---------------------------------------------------------------
# Sumber data untuk database/sync_dari_aiven.bat (salin Aiven -> XAMPP)
# Isi sama dengan pengaturan DB_* di Vercel.
# ---------------------------------------------------------------
AIVEN_DB_HOST=mysql-1f97f1c1-alifmaulanarangkuti-7650.j.aivencloud.com
AIVEN_DB_PORT=22147
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=
