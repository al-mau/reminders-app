{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.8.0",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/(api/)?lib/.*",
      "status": 404
    },
    {
      "src": "/(\\.env.*|\\.git.*|database/.*|xampp/.*|[^/]+\\.(md|txt))",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/api/index.php"
    },
    {
      "src": "/([^/]+\\.php)",
      "dest": "/api/$1"
    }
  ]
}
