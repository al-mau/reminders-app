# Konfigurasi untuk menjalankan aplikasi di XAMPP (localhost).
# Copy file ini lalu ganti namanya menjadi .env

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reminders_db
DB_USER=root
DB_PASSWORD=
DB_SSL=false

# Isi jika ingin mencoba kirim WA dari localhost
FONNTE_TOKEN=
WA_TARGET=

# Saluran notifikasi: wa (default), telegram, atau wa,telegram (keduanya)
NOTIF_VIA=wa
# Telegram Bot (gratis): token dari @BotFather, chat id orang/grup (bisa lebih dari 1, pisah koma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

CRON_SECRET=rahasia-lokal
ALLOW_REGISTER=false
APP_TIMEZONE=Asia/Jakarta
APP_DEBUG=true

# ---------------------------------------------------------------
# Sumber data untuk database/sync_dari_aiven.bat (salin Aiven -> XAMPP)
# Isi sama dengan pengaturan DB_* di Vercel.
# ---------------------------------------------------------------
AIVEN_DB_HOST=mysql-1f97f1c1-alifmaulanarangkuti-7650.j.aivencloud.com
AIVEN_DB_PORT=22147
AIVEN_DB_NAME=defaultdb
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=
