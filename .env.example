# Salin menjadi .env untuk development lokal (XAMPP). JANGAN commit file .env!
# Di Vercel: isi variabel yang sama di Project Settings -> Environment Variables.

DB_HOST=mysql-xxxxxxxx-namaproject.j.aivencloud.com
DB_PORT=22147
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=isi_password_aiven
# Opsional: path ca.pem dari Aiven (Overview -> CA certificate) untuk verifikasi SSL penuh
DB_SSL_CA=
# Set false jika memakai MySQL lokal tanpa SSL
DB_SSL=true

# WhatsApp via Fonnte
FONNTE_TOKEN=isi_token_fonnte
WA_TARGET=08xxxxxxxxxx

# Saluran notifikasi, pisahkan dengan koma: wa (default), telegram, email. Contoh: wa,telegram,email
NOTIF_VIA=wa
# Telegram Bot (gratis): token dari @BotFather, chat id orang/grup (bisa lebih dari 1, pisah koma)
TELEGRAM_BOT_TOKEN=
# Opsional: penerima Telegram bisa diatur dari dashboard (kartu Penerima Telegram)
TELEGRAM_CHAT_ID=

# Email (SMTP via PHPMailer). Gmail: aktifkan Verifikasi 2 Langkah, lalu buat App Password
# (myaccount.google.com/apppasswords) dan isi di SMTP_PASS. JANGAN pakai password Gmail biasa.
# Agar pengingat otomatis juga dikirim lewat email, tambahkan email di NOTIF_VIA (contoh: wa,telegram,email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opsional: alamat & nama pengirim (default: SMTP_USER dan "Pengingat Deadline")
EMAIL_PENGIRIM=
EMAIL_NAMA_PENGIRIM=Pengingat Deadline
# Opsional: penerima email bisa diatur dari dashboard (menu Penerima -> Email)
EMAIL_TARGET=

# Kunci rahasia untuk cron-job.org -> /cron_wa_reminder.php?key=ISI_INI
CRON_SECRET=ganti_dengan_string_acak_panjang

# true = halaman Daftar terbuka untuk umum. Default false (akun dibuat lewat menu Kelola User)
ALLOW_REGISTER=false
APP_TIMEZONE=Asia/Jakarta
# true = tampilkan error PHP di layar (hanya untuk lokal)
APP_DEBUG=false
