# Pengaturan Aplikasi Pengingat Hari Jadi (XAMPP).
# Copy file ini lalu ganti namanya menjadi .env, kemudian isi bagian yang kosong.
# JANGAN commit / bagikan file .env (berisi token & password).

# Database MySQL XAMPP (bawaan: user root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pengingat_hari_jadi
DB_USER=root
DB_PASSWORD=

# Pengingat dikirim berapa hari sebelum hari jadi (7 = H-7)
PENGINGAT_HARI=7

# Saluran notifikasi, pisahkan dengan koma: wa, telegram, email
NOTIF_VIA=wa,telegram,email

# WhatsApp via Fonnte: token device dari dashboard fonnte.com
FONNTE_TOKEN=
# Opsional: nomor cadangan bila belum ada penerima WA aktif di menu Penerima (pisah koma)
WA_TARGET=

# Telegram Bot (gratis): token dari @BotFather
TELEGRAM_BOT_TOKEN=
# Opsional: chat id cadangan bila belum ada penerima Telegram aktif di menu Penerima
TELEGRAM_CHAT_ID=

# Email (SMTP via PHPMailer). Gmail: aktifkan Verifikasi 2 Langkah, lalu buat App Password
# (myaccount.google.com/apppasswords) dan isi di SMTP_PASS. JANGAN pakai password Gmail biasa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Opsional: alamat & nama pengirim (default: SMTP_USER dan "Pengingat Hari Jadi")
EMAIL_PENGIRIM=
EMAIL_NAMA_PENGIRIM=Pengingat Hari Jadi
# Opsional: alamat cadangan bila belum ada penerima email aktif di menu Penerima
EMAIL_TARGET=

# Kunci untuk memanggil cron_pengingat.php lewat URL (min. 16 karakter acak).
# Tidak dipakai oleh kirim_pengingat.bat (Task Scheduler), hanya bila dipanggil dari luar.
CRON_SECRET=

APP_TIMEZONE=Asia/Jakarta
# true = tampilkan error PHP di layar (hanya untuk mencari masalah)
APP_DEBUG=false
